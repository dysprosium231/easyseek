# OpenAlex requires a free API key for every request (since 2026-02-13).
OPENALEX_API_KEY=

# Optional contact details and API keys. Leave blank when unused.
SCANSCI_FIND_CONTACT_EMAIL=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
OPENCITATIONS_ACCESS_TOKEN=
UNPAYWALL_EMAIL=
NCBI_EMAIL=
NCBI_API_KEY=
EUROPE_PMC_EMAIL=
BAIDU_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Network resilience and source etiquette.
SCANSCI_FIND_HTTP_TIMEOUT=20
SCANSCI_FIND_HTTP_ATTEMPTS=3
DBLP_MIN_INTERVAL_SECONDS=1.0
OPENCITATIONS_MIN_INTERVAL_SECONDS=0.34

# JSON array containing an authorized external CNKI MCP command.
SCANSCI_FIND_CNKI_MCP_COMMAND=

# Existing ScanSci integrations.
JOURNAL_SCOUT_REPO=
JOURNAL_SCOUT_DATA_PATH=
SCANSCI_BROWSER_COMMAND=
SCANSCI_PDF_REPO=

# Concurrency tuning (1 forces serial execution).
SCANSCI_FIND_SEARCH_WORKERS=8
SCANSCI_FIND_OA_WORKERS=8
